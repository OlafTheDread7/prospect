# =====================================================
# PROSPECT — environment variables
# =====================================================
# Copy this to .env and fill in. The agent works in mock
# mode with no keys; flip MOCK_* off when you're ready.
# =====================================================

# --------- Supabase (required for non-mock mode) ------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------- Frontend (Next.js) -------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --------- LLM (vLLM on RunPod Serverless) ------------
# An HTTP endpoint that speaks OpenAI-compatible chat completions.
# Example: https://api.runpod.ai/v2/<endpoint>/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_PRIMARY=qwen2.5-32b-instruct
LLM_MODEL_ESCALATION=llama-3.3-70b-instruct

# --------- Retrieval ----------------------------------
FIRECRAWL_API_KEY=
BRAVE_API_KEY=

# --------- Enrichment ---------------------------------
APOLLO_API_KEY=

# --------- Observability (optional) -------------------
AXIOM_TOKEN=
AXIOM_DATASET=prospect

# --------- Feature flags ------------------------------
# When true, the agent uses in-process mocks and requires
# no external API keys. Use for local dev.
MOCK_LLM=true
MOCK_CRAWL=true
MOCK_ENRICH=true
MOCK_SEARCH=true

# Worker loop polling interval (seconds)
WORKER_POLL_INTERVAL=5
